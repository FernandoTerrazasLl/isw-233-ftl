<div class="projects__project">
  <img src="{{image}}" alt="{{imageAlt}}" class="projects__project-image">
  <div class="projects__project-info">
    <h4 class="projects__project-title">{{title}}</h4>
    <a href="{{url}}" class="projects__project-link">
      <img src="{{repositoryIcon}}" alt="GitHub icon" class="projects__project-link-icon">
      {{repositoryLabel}}
    </a>
  </div>
</div>